El reto es abrir la preview de DSErrorView con
`fvm flutter widget-preview start`. Como ejemplo de escribir una, se añade
otra de DSLoadingIndicator con el tema de la app; no necesita
localizations porque el widget no lee textos del ARB.
---
 .../shared/design_system/views/ds_loading_indicator.dart     | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/lib/presentation/shared/design_system/views/ds_loading_indicator.dart b/lib/presentation/shared/design_system/views/ds_loading_indicator.dart
index cf6042c..a8b03a5 100644
--- a/lib/presentation/shared/design_system/views/ds_loading_indicator.dart
+++ b/lib/presentation/shared/design_system/views/ds_loading_indicator.dart
@@ -1,6 +1,11 @@
 import 'dart:math' as math show sin, pi;
 
 import 'package:flutter/material.dart';
+import 'package:flutter/widget_previews.dart';
+import 'package:flutter_template/presentation/shared/design_system/theme/theme_factory.dart';
+
+@Preview(name: 'DSLoadingIndicator', theme: previewTheme)
+Widget dsLoadingIndicatorPreview() => const DSLoadingIndicator(size: 40);
 
 class DSLoadingIndicator extends StatefulWidget {
   final Color? color;
